{
  "name": "claude-code-dashboard",
  "version": "0.3.2",
  "description": "Claude Code の CLAUDE.md・スキル・実行ログ等をローカルで可視化・編集するダッシュボード",
  "author": "Claude Code Dashboard Contributors",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "electron:dev": "next build && node scripts/prepare-standalone.mjs && electron .",
    "dist:win": "next build && node scripts/prepare-standalone.mjs && electron-builder --win portable --x64",
    "package:sample-data": "node scripts/package-sample-data.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "js-yaml": "^5.2.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^38.5.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
