# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dashboard: user-specific monitored project registry (contains local absolute paths)
/config/projects.json
/config/projects.local.json

# dashboard: real ~/.claude data provided for local testing (contains personal session logs)
/sample-data-user/

# dashboard: import機能が上書き前に自動生成するバックアップファイル
*.ccd-backup.*
