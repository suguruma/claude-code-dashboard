# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dashboard: user-specific monitored project registry (contains local absolute paths)
/config/projects.json
/config/projects.local.json
# dashboard: Claude Desktop データフォルダの場所など、利用者ごとの設定（ローカルの絶対パスを含みうる）
/config/desktop-sessions.json
# dashboard: 要対応のデスクトップ通知のオン・オフ(利用者ごとの設定)
/config/desktop-notify.json
# dashboard: 利用上限の価格表の上書き・公式値の記録の場所など、利用者ごとの設定
/config/usage.json
# dashboard: 組織のルールのページで読む追加のファイルの場所など、利用者ごとの設定（ローカルの絶対パスを含みうる）
/config/org-rules.json
# dashboard: 組織の「つながり」の役割の見分け方・担当と指示のファイル・台帳の結び（ローカルの絶対パスを含みうる）
/config/relations.json
# dashboard: リソースのページ(⑭)で読む作業計画・待ち行列・CPU の記録の場所（ローカルの絶対パスを含みうる）
/config/monitor.json
# dashboard: スマホから見る(⑪)のオン・オフ・登録した端末(鍵のハッシュ)・登録コード(ハッシュ)・待ち受けの状態(利用者ごと)
/config/lan-access.json
/config/lan-devices.json
/config/lan-pairing.json
/config/lan-status.json

# dashboard: real ~/.claude data provided for local testing (contains personal session logs)
/sample-data-user/

# dashboard: import機能が上書き前に自動生成するバックアップファイル
*.ccd-backup.*

# electron-builder のexeビルド出力
/release/

# dashboard: AI駆動開発の内部作業ログ（率直なユーザー指摘・自己批評を含むため非公開、ローカルのみで保持）
/docs/plan.md

# dashboard: 開発時の指示プロンプト原文・仕様原案・ラウンド単位の実装経緯など、
# 「作っている過程」が分かってしまう内部資料（非公開、ローカルのみで保持）
/TODO.md
/docs/spec.md
/docs/design-reference/

# electron-builder が sample-data から生成する配布用zip
/dist-assets/
